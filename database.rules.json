{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email))",
      ".indexOn": [
        "category",
        "visible",
        "timestamp",
        "price"
      ],
      "$productId": {
        "stock": {
          ".write": true
        }
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email))"
    },

    "orders": {
      ".read": "auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email) || (query.orderByChild == 'userId' && query.equalTo == auth.uid))",
      ".write": true,
      ".indexOn": [
        "userId",
        "timestamp",
        "status"
      ],
      "$orderId": {
        ".read": true,
        ".write": "auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email)) || !data.exists()"
      }
    },

    "promos": {
      ".read": true,
      ".indexOn": [
        "code"
      ],
      "$promoId": {
        ".write": "auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email))",
        "usedCount": {
          ".write": true
        }
      }
    },

    "activityLog": {
      ".read": "auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email))",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "type"
      ]
    },

    "supportTickets": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "visitorId",
        "status",
        "createdAt"
      ]
    },

    "seoSettings": {
      ".read": true,
      ".write": "auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email))"
    },

    "userProfiles": {
      ".indexOn": [
        "visitorId"
      ],
      "$uid": {
        ".read": "($uid === auth.uid) || $uid.beginsWith('visitor_') || (auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email)))",
        ".write": "($uid === auth.uid) || $uid.beginsWith('visitor_') || (auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email)))"
      }
    },

    "reviews": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "productId",
        "visitorId",
        "timestamp"
      ]
    },

    "newsletter": {
      ".read": "auth != null && (root.child('settings/adminEmails').child(auth.token.email.replace('.', ',')).exists() || (root.child('settings/ownerEmail').exists() && root.child('settings/ownerEmail').val() == auth.token.email))",
      ".write": true,
      ".indexOn": [
        "timestamp"
      ]
    }
  }
}